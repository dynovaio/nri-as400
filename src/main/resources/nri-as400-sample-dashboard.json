{
  "name": "IBM iSeries (AS400) Overview",
  "description": "Comprehensive overview of IBM iSeries (AS400) systems, memory pools, disk usage, active jobs, and message queues.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "IBM iSeries (AS400) Overview",
      "description": null,
      "widgets": [
        {
          "title": "Active Jobs",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(numberActiveJobsInSystem) AS 'Active Jobs' FROM `AS400:SystemStatusEvent`"
              }
            ]
          }
        },
        {
          "title": "CPU Utilization",
          "layout": {
            "column": 4,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(percentProcessingUnitUsed) AS 'CPU %' FROM `AS400:SystemStatusEvent`"
              }
            ]
          }
        },
        {
          "title": "System ASP Used",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(percentSystemASPUsed) AS 'ASP Used %' FROM `AS400:SystemStatusEvent`"
              }
            ]
          }
        },
        {
          "title": "Signed-On Users",
          "layout": {
            "column": 10,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(currentUsersSignedOn) AS 'Users' FROM `AS400:SystemStatusEvent`"
              }
            ]
          }
        },
        {
          "title": "CPU & Interactive Performance Trends",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(percentProcessingUnitUsed) AS 'CPU %', average(percentCurrentInteractivePerformance) AS 'Interactive %' FROM `AS400:SystemStatusEvent` SINCE 1 HOUR AGO TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "System ASP & Unprotected Storage Used",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(percentSystemASPUsed) AS '% ASP Used', average(currentUnprotectedStorageUsed) / 1024 AS 'Unprotected Storage (GB)' FROM `AS400:SystemStatusEvent` SINCE 1 HOUR AGO TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Memory Pool Sizes (GB)",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(poolSize) / 1024 / 1024 AS 'Pool Size (GB)' FROM `AS400:MemoryStatusEvent` FACET poolName SINCE 30 MINUTES AGO"
              }
            ]
          }
        },
        {
          "title": "Memory Faults & Paging Rates",
          "layout": {
            "column": 5,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(databaseFaults + nondatabaseFaults) AS 'Faults/sec', average(databasePages + nondatabasePages) AS 'Pages/sec' FROM `AS400:MemoryStatusEvent` FACET poolName SINCE 1 HOUR AGO TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Disk Unit Storage Usage",
          "layout": {
            "column": 9,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(percentUsed) AS '% Used' FROM `AS400:DiskUsageEvent` FACET resourceName SINCE 30 MINUTES AGO LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Job Status Distribution",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM `AS400:JobList` FACET jobStatus SINCE 1 HOUR AGO"
              }
            ]
          }
        },
        {
          "title": "Jobs by Subsystem",
          "layout": {
            "column": 5,
            "row": 10,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) AS 'Jobs' FROM `AS400:JobList` FACET jobSubsystem SINCE 1 HOUR AGO"
              }
            ]
          }
        },
        {
          "title": "Batch Jobs Overview",
          "layout": {
            "column": 9,
            "row": 10,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT latest(numberOfBatchJobsRunning) AS 'Running', latest(numberOfBatchJobsHeldOnQueue) AS 'Held on Queue', latest(numberOfBatchJobsWaitingForMessage) AS 'Waiting for Msg' FROM `AS400:SystemStatusEvent` SINCE 1 HOUR AGO TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Recent Message Queue Messages",
          "layout": {
            "column": 1,
            "row": 13,
            "width": 12,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT timestamp, host, queue, severity, messageID, message FROM `AS400:MessageQueueEvent` SINCE 1 DAY AGO LIMIT 100"
              }
            ]
          }
        }
      ]
    }
  ]
}
